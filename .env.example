# Vercel → visionbotix-site → Settings → Environment Variables (never commit real values)
# Contact form email (api/contact.js). Without RESEND_API_KEY the form offers a pre-filled email instead.
RESEND_API_KEY=
CONTACT_TO=info@visionbotix.com
CONTACT_FROM=Visionbotix website <website@visionbotix.com>

# Optional: copy every lead to a Google Sheet or a CRM (S6). Any URL that accepts a JSON POST: a Google Apps Script
# web app (scripts/lead-sheet.gs), Zapier/Make webhook, HubSpot workflow… LEAD_WEBHOOK_SECRET is sent as "secret".
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Cloudflare Turnstile (S6). Set BOTH or neither. The site key is public (also readable at build time).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics (optional here; can also be pasted into src/data/site.ts). Loaded only after cookie consent.
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=
