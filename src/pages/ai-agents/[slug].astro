<script>
  // "Try it live" (S7): swap the scripted preview for the live demo widget, and back.
  const sw = document.querySelector<HTMLButtonElement>('[data-demo-live]');
  if (sw) {
    const scripted = document.querySelector<HTMLElement>('[data-demo-scripted]')!;
    const live = document.querySelector<HTMLElement>('#agent-live')!;
    const label = document.querySelector<HTMLElement>('[data-demo-label]')!;
    sw.addEventListener('click', () => {
      const on = live.hidden;
      live.hidden = !on;
      scripted.hidden = on;
      sw.setAttribute('aria-expanded', String(on));
      sw.querySelector('span')!.textContent = on ? 'Scripted preview' : 'Try it live';
      label.textContent = on ? 'Live demo · real AI' : 'See it work';
      if (on) {
        live.querySelector<HTMLElement>('[data-live-demo]')!.dispatchEvent(new FocusEvent('focusin'));
        window.dispatchEvent(new CustomEvent('vbx:track', { detail: { event: 'demo_open', demo: live.querySelector<HTMLElement>('[data-live-demo]')!.dataset.liveDemo, location: 'agent-hero' } }));
      }
    });
  }
</script>
