---
/**
 * Country page template (S9, PLAN §6.2): genuinely local substance, no doorway pages. Hero with a "working with us from
 * <country>" panel (live overlap computed from the page's zones + our shift) → why → proof → recommended agents with
 * their local angle → mid CTA → prices in the local currency (computed, approximate, dated) → local rules + contracts,
 * data transfers and invoices → time zones table → local industries → live demos → custom builds → optional Markdown
 * body → FAQ (+ generated price question) → other countries → CTA.
 * Copy in `src/content/locations/<slug>.md`; numbers from `src/lib/locations.ts` (pricing.ts, site.ts).
 * Template copy is spelling-neutral on purpose: UK, AU and PK pages are written in UK spelling (D65).
 */
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Accordion from '@/components/Accordion.astro';
import CtaBand from '@/components/CtaBand.astro';
import RelatedReading from '@/components/RelatedReading.astro';
import LocalLinks from '@/components/LocalLinks.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import Stat from '@/components/Stat.astro';
import { site } from '@/data/site';
import { locations as locationCatalogue } from '@/data/catalogue';
import { audit, localMoney, usMoney, currencyNames, projectFrom } from '@/data/pricing';
import { getServices } from '@/lib/services';
import { getIndustries, agentItem, demoFor } from '@/lib/industries';
import { getLocations, overlap, overlapLabel, shiftLabel, hh, priceRows, fxLabel, locationFaq, locationOffers, delivered, type LocationEntry } from '@/lib/locations';
import { service } from '@/lib/schema';

export async function getStaticPaths() {
  const all = await getLocations();
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props {
  entry: LocationEntry;
}
const { entry } = Astro.props;
const d = entry.data;
const slug = entry.id;
const path = `/locations/${slug}/`;
const { Content } = await render(entry);
const hasBody = !!entry.body?.trim();

const zones = overlap(d);
const main = zones[0]!;
const isDelivered = delivered(d);
const local = d.currency !== 'USD';
const currencyName = currencyNames[d.currency];
const utc = (o: number) => (o === 0 ? 'UTC' : `UTC${o > 0 ? '+' : '−'}${Math.abs(o)}`);
const rows = priceRows(d);
const team = d.popular.map((p) => ({ ...agentItem(p.agent.id), body: p.body, demo: demoFor(p.agent.id), price: rows.find((r) => r.href === `/ai-agents/${p.agent.id}/`)! }));
const lead = team[0]!;
const demos = team.filter((a) => a.demo);
const faqs = [...d.faq.slice(0, 1), locationFaq(d), ...d.faq.slice(1)];
const allServices = await getServices();
const relServices = d.services.map((r) => allServices.find((s) => s.id === r.id)!).filter(Boolean);
const allIndustries = await getIndustries();
const sectors = d.industries.map((i) => ({ entry: allIndustries.find((e) => e.id === i.industry.id)!, body: i.body })).filter((s) => s.entry);
const others = locationCatalogue.filter((l) => l.slug !== slug);
const updated = d.updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const f = site.facts;

/** 24-hour bar positions (client's local time), as percentages. */
const pct = (h: number) => `${((h / 24) * 100).toFixed(3)}%`;
const shiftSegs: [number, number][] =
  main.shiftLocal[1] > main.shiftLocal[0] || main.shiftLocal[1] === 0
    ? [[main.shiftLocal[0], main.shiftLocal[1] || 24]]
    : [[main.shiftLocal[0], 24], [0, main.shiftLocal[1]]];
const groups = [
  { key: 'agent', label: 'Packaged AI agents (setup + monthly)' },
  { key: 'start', label: 'Low-risk start' },
  { key: 'build', label: 'Custom builds, fixed price after scoping (from)' },
  { key: 'team', label: 'Dedicated engineers' },
] as const;
---

<BaseLayout
  seo={{ title: d.seo.title, description: d.seo.description, modifiedTime: d.updated.toISOString() }}
  lang={d.lang}
  schema={[service({ name: `AI agent and software development for ${d.who}`, description: d.summary, path, serviceType: d.keywords.primary, offers: locationOffers(d), areaServed: [d.code] })]}
>
  <!-- ============ Hero ============ -->
  <section class="container lo-hero" aria-labelledby="lo-title">
    <div class="lo-copy">
      <Breadcrumbs items={[{ name: 'Where we work', href: '/locations/' }, { name: d.name, href: path }]} />
      <p class="lo-eyebrow eyebrow">
        <span class="lo-code mono" aria-hidden="true">{d.code}</span>
        For {d.who}
      </p>
      <h1 id="lo-title" class="lo-title">{d.h1}</h1>
      <p class="lead lo-lead">{d.summary}</p>
      <ul role="list" class="lo-facts">
        <li><Icon name="clock" size={16} /><span>Live overlap: <strong>{overlapLabel(main)}</strong></span></li>
        <li><Icon name="wallet" size={16} /><span>{lead.name}: <strong>{local ? '≈ ' : 'from '}{lead.price.local}</strong></span></li>
        {isDelivered && <li><Icon name="badge-check" size={16} /><span>Projects delivered for clients in {d.inName}</span></li>}
      </ul>
      <div class="cluster lo-ctas">
        <Button href={site.contact.bookingUrl} size="lg" icon="arrow-right" data-event="book_call" data-event-location={`location-hero-${slug}`}>Book a free strategy call</Button>
        {
          lead.demo ? (
            <Button href={`/demos/${lead.demo.id}/`} size="lg" variant="glass" icon="circle-play" data-event="demo_cta" data-event-location={`location-hero-${slug}`}>
              Try the {lead.name} live
            </Button>
          ) : (
            <Button href="#prices" size="lg" variant="glass">See prices</Button>
          )
        }
      </div>
    </div>

    <aside class="desk glass-strong" aria-labelledby="desk-title">
      <div class="desk-head">
        <span class="desk-icon" aria-hidden="true"><Icon name="globe" size={20} /></span>
        <div>
          <p id="desk-title" class="desk-name">Working with us from {d.inName}</p>
          <p class="mono subtle desk-sub">{main.city} · {utc(d.zones[0]!.offset)}</p>
        </div>
      </div>

      <div class="dayline" role="img" aria-label={`Our team works ${hh(main.shiftLocal[0])} to ${hh(main.shiftLocal[1])} ${main.abbr}; your working day is ${hh(d.workday[0])} to ${hh(d.workday[1])}; live overlap ${main.hours} hours.`}>
        <div class="dl-row">
          <span class="dl-label small">Your day</span>
          <span class="dl-track"><span class="dl-seg dl-you" style={`--a:${pct(d.workday[0])};--w:${pct(d.workday[1] - d.workday[0])}`}></span></span>
        </div>
        <div class="dl-row">
          <span class="dl-label small">Our team</span>
          <span class="dl-track">
            {shiftSegs.map(([a, b]) => <span class="dl-seg dl-us" style={`--a:${pct(a)};--w:${pct(b - a)}`} />)}
            {main.hours > 0 && <span class="dl-seg dl-both" style={`--a:${pct(main.from)};--w:${pct(main.to - main.from)}`} />}
          </span>
        </div>
        <div class="dl-ticks mono" aria-hidden="true"><span>00</span><span>06</span><span>12</span><span>18</span><span>24</span></div>
      </div>

      <ul role="list" class="desk-list">
        <li>
          <span class="desk-k small muted">Live overlap</span>
          <span class="desk-v"><strong>{main.hours} h</strong> a working day · {overlapLabel(main)}</span>
        </li>
        <li>
          <span class="desk-k small muted">Our shift</span>
          <span class="desk-v">{hh(main.shiftLocal[0])}–{hh(main.shiftLocal[1])} {main.abbr}{d.zones[0]!.offset !== site.hours.utcOffset && <span class="muted small"> ({shiftLabel(d)})</span>}</span>
        </li>
        <li>
          <span class="desk-k small muted">Prices</span>
          <span class="desk-v">{local ? <>Shown in {d.currency} (≈) and US$</> : 'US$, fixed quote per project'}</span>
        </li>
        <li>
          <span class="desk-k small muted">Your agents</span>
          <span class="desk-v">Run 24/7 in your time zone</span>
        </li>
      </ul>
      <p class="desk-foot small">
        <span class="live-dot" aria-hidden="true"></span>
        <span class="muted">{d.code === site.address.country ? `Team of ${f.teamSize} at our studio in ${site.address.locality}: meet us in person.` : `Team of ${f.teamSize} in ${site.address.locality}, Pakistan. No local office, no virtual address.`}</span>
      </p>
    </aside>
  </section>

  <!-- ============ Why ============ -->
  <Section id="why" eyebrow="Why us" title={`Why ${d.who} work with Visionbotix.`} space="tight">
    <ul role="list" class="whys" data-cols={d.why.length === 4 ? 2 : 3} data-stagger>
      {
        d.why.map((w) => (
          <li class="why glass-subtle spotlight">
            <h3 class="h4">{w.title}</h3>
            <p class="muted small">{w.body}</p>
          </li>
        ))
      }
    </ul>
    <div class="proof glass-subtle" data-reveal>
      <Stat value={f.foundingYear ? new Date().getFullYear() - f.foundingYear : null} suffix="+" label={`years building software, since ${f.foundingYear}`} />
      <Stat value={f.teamSize} label="Engineers and designers" />
      <Stat value={f.projectsDelivered} suffix="+" label="Projects delivered" />
      <Stat value={f.countriesServed} label="Countries served" />
    </div>
  </Section>

  <!-- ============ Recommended agents ============ -->
  <Section id="agents" eyebrow={`Popular in ${d.inName}`} title={`The AI agents we recommend first for ${d.who}.`} lead="Each one is a packaged agent with a public price and a live demo. You can start with one and add the next when it pays off.">
    <ul role="list" class="agents" data-cols={team.length === 4 ? 2 : 3} data-stagger>
      {
        team.map((a) => (
          <li class="agent glass-subtle spotlight lift">
            <a class="card-cover" href={`/ai-agents/${a.slug}/`} aria-hidden="true" tabindex="-1" />
            <div class="agent-top">
              <span class="agent-icon" aria-hidden="true">
                <Icon name={a.icon} size={18} />
              </span>
              <span class="agent-price mono small">{local ? '≈ ' : ''}{a.price.local}</span>
            </div>
            <h3 class="h4">
              <a href={`/ai-agents/${a.slug}/`}>{a.name}</a>
            </h3>
            <p class="muted small">{a.body}</p>
            {local && <p class="agent-usd mono small subtle">{a.price.usd}</p>}
          </li>
        ))
      }
    </ul>
  </Section>

  <CtaBand
    title={`See what an AI agent would change for your team in ${d.inName}.`}
    text={`In a free 30-minute call, held inside your working hours, we look at where your team loses the most time, recommend the agent that pays off first and send a fixed quote within 24 hours.`}
    location={`location-mid-${slug}`}
  />

  <!-- ============ Prices ============ -->
  <Section id="prices" eyebrow={local ? `Prices in ${d.currency}` : 'Prices'} title={local ? `What it costs, in ${currencyName}.` : 'What it costs.'} lead={local ? `Public "from" prices, shown in ${d.currency} for orientation and in US dollars, the currency our prices are set in.` : 'Public "from" prices. Your fixed quote states the exact amount before any work starts.'}>
    <div class="prices glass-subtle" data-reveal>
      <table>
        <thead>
          <tr>
            <th scope="col">Offer</th>
            {local && <th scope="col">≈ {d.currency}</th>}
            <th scope="col">US$</th>
          </tr>
        </thead>
        {
          groups.map((g) => (
            <tbody>
              <tr class="pr-group">
                <th scope="colgroup" colspan={local ? 3 : 2}>{g.label}</th>
              </tr>
              {rows
                .filter((r) => r.group === g.key)
                .map((r) => (
                  <tr>
                    <th scope="row">{r.href ? <a href={r.href}>{r.name}</a> : r.name}</th>
                    {local && <td class="pr-local">{r.local}</td>}
                    <td class="mono small">{r.usd}</td>
                  </tr>
                ))}
            </tbody>
          ))
        }
      </table>
    </div>
    <p class="fx-note small muted">
      {local && <>Approximate, rounded, at {fxLabel(d.currency)}. </>}Monthly fees cover hosting, monitoring, weekly tuning and a fair-use volume; usage above that is passed through at cost. The {audit.name} is credited in full against a build. Your fixed quote states the exact amount and currency.
    </p>
    <div class="cluster sec-foot">
      <Button href="/pricing/" variant="glass" icon="arrow-right">See full pricing</Button>
      <Button href="/estimate/" variant="glass" icon="calculator">Estimate a custom build</Button>
    </div>
  </Section>

  <!-- ============ Rules + contracts ============ -->
  <Section id="compliance" eyebrow="Rules and contracts" title={`Built for the rules ${d.who} work under.`} lead="We design every setup around the regulations that apply to you. Compliance stays your responsibility, so your legal or compliance lead signs off the setup before go-live.">
    <ul role="list" class="regs" data-cols={d.compliance.length === 4 ? 2 : 3} data-stagger>
      {
        d.compliance.map((c) => (
          <li class="reg glass-subtle">
            <div class="reg-top">
              <h3 class="h4">{c.name}</h3>
              <span class="reg-scope mono">{c.scope}</span>
            </div>
            <p class="small muted">{c.body}</p>
          </li>
        ))
      }
    </ul>
    <div class="contracts glass-subtle" data-reveal>
      <h3 class="trust-head"><Icon name="file-signature" size={18} /> Contracts, data and invoices</h3>
      <dl class="ct-list">
        {
          d.contracts.map((c) => (
            <div class="ct-row">
              <dt>{c.title}</dt>
              <dd class="small muted">{c.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <!-- ============ Time zones ============ -->
  <Section id="hours" eyebrow="Time zones" title="Hours that overlap your working day." lead={`Our team is in ${site.address.locality}, Pakistan (${site.hours.tz}, UTC+${site.hours.utcOffset}, no daylight saving). Projects for ${d.who} run on a ${shiftLabel(d)} shift, so standups, reviews and calls happen live.`} width="narrow">
    <div class="zones glass-subtle" data-reveal>
      <table>
        <thead>
          <tr>
            <th scope="col">City</th>
            <th scope="col">Our shift, your time</th>
            <th scope="col">Live overlap</th>
          </tr>
        </thead>
        <tbody>
          {
            zones.map((z) => (
              <tr>
                <th scope="row">{z.city}</th>
                <td class="mono small">{hh(z.shiftLocal[0])}–{hh(z.shiftLocal[1])} {z.abbr}</td>
                <td>
                  <strong>{z.hours} h</strong> <span class="muted small">{overlapLabel(z)}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="fx-note small muted">{d.overlapNote}</p>
    <ul role="list" class="checks how">
      <li><Icon name="check" size={15} strokeWidth={2.5} /> One named lead for your project, reachable in your working hours</li>
      <li><Icon name="check" size={15} strokeWidth={2.5} /> A weekly demo of working software, and a shared Slack, Teams or WhatsApp channel</li>
      <li><Icon name="check" size={15} strokeWidth={2.5} /> Your AI agents work around the clock; the overlap is for the people</li>
    </ul>
  </Section>

  <!-- ============ Industries ============ -->
  <Section id="industries" eyebrow="Sectors" title={`Industries we build for in ${d.inName}.`} space="tight">
    <ul role="list" class="sectors" data-cols={sectors.length === 4 ? 2 : 3} data-stagger>
      {
        sectors.map(({ entry: e, body }) => (
          <li class="sector glass-subtle spotlight lift">
            <a class="card-cover" href={`/industries/${e.id}/`} aria-hidden="true" tabindex="-1" />
            <span class="agent-icon" aria-hidden="true">
              <Icon name={e.data.icon} size={18} />
            </span>
            <h3 class="h4">
              <a href={`/industries/${e.id}/`}>{e.data.name}</a>
            </h3>
            <p class="muted small">{body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- ============ Live demos ============ -->
  {
    demos.length > 0 && (
      <Section id="demos" eyebrow="Try them live" title="Talk to these agents now, no sign-up." lead="Each demo runs on a fictional business with sample data. You see every tool call, guardrail and approval the agent makes." space="tight">
        <ul role="list" class="demo-grid" data-stagger>
          {demos.map((a) => (
            <li class="demo glass-subtle spotlight lift">
              <a class="card-cover" href={`/demos/${a.demo!.id}/`} aria-hidden="true" tabindex="-1" />
              <span class="agent-icon" aria-hidden="true">
                <Icon name={a.icon} size={18} />
              </span>
              <h3 class="h4">
                <a href={`/demos/${a.demo!.id}/`} data-event="demo_cta" data-event-location={`location-demos-${slug}`}>
                  {a.name} demo
                </a>
              </h3>
              <p class="small muted">{a.demo!.businessLine}</p>
              <span class="demo-go small">
                Try it live <Icon name="arrow-right" size={14} />
              </span>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <!-- ============ Custom builds ============ -->
  <Section id="services" eyebrow="Custom builds" title="Need more than a packaged agent?" lead={`We also design and build software for ${d.who}, from a single integration to a full platform, at a fixed price per milestone. Custom AI agents start from ${local ? `about ${localMoney(projectFrom.customAgent, d.currency)} (${usMoney(projectFrom.customAgent)})` : usMoney(projectFrom.customAgent)}.`} space="tight">
    <ul role="list" class="rel-grid" data-stagger>
      {relServices.map((s) => <ServiceCard slug={s.id} name={s.data.name} line={s.data.tagline} icon={s.data.icon} />)}
    </ul>
  </Section>

  <!-- ============ Optional Markdown body ============ -->
  {
    hasBody && (
      <Section id="compare" width="narrow" space="tight">
        <div class="prose lo-body glass-subtle" data-reveal>
          <Content />
        </div>
      </Section>
    )
  }

  <!-- ============ FAQ ============ -->
  <Section id="faq" eyebrow="FAQ" title={`Working with Visionbotix from ${d.inName}: common questions.`} width="narrow" align="center">
    <Accordion items={faqs} schema name="location-faq" />
    <p class="faq-more small muted">
      Something else? <a class="link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a> or <a class="link" href={site.contact.bookingUrl}>book a call</a>.
      <span class="updated mono">Updated {updated}</span>
    </p>
  </Section>

  <!-- ============ Other countries ============ -->
  <Section id="related" eyebrow="Where we work" title="Other countries we work with." space="tight">
    <p class="rel-more">
      {
        others.map((l) => (
          <a class="rel-chip glass-chip press" href={`/locations/${l.slug}/`}>
            <span class="chip-code mono" aria-hidden="true">{l.code}</span>
            {l.name}
          </a>
        ))
      }
      <a class="rel-chip glass-chip press" href="/locations/">
        <Icon name="arrow-right" size={14} />
        All locations
      </a>
    </p>
  </Section>

  <!-- ============ Guides (S10): posts that link to this page ============ -->
  <LocalLinks location={slug} />
  <RelatedReading />

  <CtaBand title="Tell us how your team works. Get a fixed quote within 24 hours." location={`location-final-${slug}`} />
</BaseLayout>

<style>
  /* ---------- hero ---------- */
  .lo-hero {
    display: grid;
    align-items: center;
    gap: clamp(2rem, 1.5rem + 3vw, 4rem);
    padding-block: calc(var(--header-h) + clamp(1.25rem, 0.5rem + 3vw, 3rem)) clamp(2rem, 1rem + 3vw, 4rem);
  }
  @media (min-width: 64rem) {
    .lo-hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      min-height: min(100svh, 52rem);
    }
  }
  .lo-copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .lo-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .lo-code {
    display: grid;
    place-items: center;
    min-inline-size: 1.9rem;
    block-size: 1.6rem;
    padding-inline: 0.35rem;
    border-radius: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
  }
  .lo-title {
    font-size: clamp(2.25rem, 1.5rem + 3.2vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    font-weight: 680;
    max-width: 17ch;
    text-wrap: balance;
  }
  .lo-lead {
    max-width: 58ch;
  }
  @media (max-width: 40rem) {
    .lo-lead {
      font-size: var(--step-0);
    }
  }
  .lo-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--step--1);
  }
  .lo-facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .lo-facts :global(.icon) {
    flex: none;
    color: var(--accent);
  }
  .lo-facts strong {
    font-weight: 620;
  }

  /* ---------- desk panel ---------- */
  .desk {
    --glass-radius: var(--radius-xl);
    display: grid;
    gap: var(--space-4);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    inline-size: 100%;
    max-inline-size: 32rem;
    justify-self: center;
  }
  @media (min-width: 64rem) {
    .desk {
      justify-self: end;
    }
  }
  .desk > * {
    position: relative;
    z-index: 2;
  }
  .desk-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block-end: var(--space-4);
    border-block-end: 1px solid var(--border);
  }
  .desk-icon {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 0.95rem;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
    box-shadow: var(--btn-primary-glow);
  }
  .desk-name {
    font-weight: 640;
    font-size: var(--step-0);
  }
  .desk-sub {
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }
  .dayline {
    display: grid;
    gap: var(--space-2);
  }
  .dl-row {
    display: grid;
    grid-template-columns: 4.75rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
  }
  .dl-label {
    color: var(--fg-muted);
  }
  .dl-track {
    position: relative;
    block-size: 0.9rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--fg) 8%, transparent);
    overflow: hidden;
  }
  .dl-seg {
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--a);
