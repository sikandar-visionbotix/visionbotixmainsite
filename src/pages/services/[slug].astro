---
/**
 * Service page template (S4, PLAN §3): hero with a "service snapshot" panel → problem → what we build → packaged agents
 * (cross-sell) → process → stack, quality and how we work → pricing and ways to work → related case studies →
 * own products (deep tech) → comparison (Markdown body) → FAQ → related services and industries → CTA.
 * Copy comes from `src/content/services/<slug>.md`; prices only from `src/data/pricing.ts` (D27, D32); case studies
 * only through getWork() (the launch gate, D18), matched by each case study's `services` field.
 */
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Steps from '@/components/Steps.astro';
import Accordion from '@/components/Accordion.astro';
import CtaBand from '@/components/CtaBand.astro';
import RelatedReading from '@/components/RelatedReading.astro';
import AgentCard from '@/components/AgentCard.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CaseCard from '@/components/CaseCard.astro';
import { site } from '@/data/site';
import { pillars, agents as agentCatalogue, industries, products, industriesLive } from '@/data/catalogue';
const IndTag = industriesLive ? 'a' : 'span';
import { guarantees } from '@/data/home';
import { engagementCopy } from '@/data/services-hub';
import { getServices, servicePricing, serviceFaq, workFor, type ServiceEntry } from '@/lib/services';
import { service } from '@/lib/schema';

export async function getStaticPaths() {
  const all = await getServices();
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}
interface Props {
  entry: ServiceEntry;
  all: ServiceEntry[];
}
const { entry, all } = Astro.props;
const d = entry.data;
const slug = entry.id;
const path = `/services/${slug}/`;
const { Content } = await render(entry);
const hasBody = !!entry.body?.trim();

const price = servicePricing(slug, d.name);
// The generated price answer goes second: high intent, and always in step with pricing.ts.
const faqs = [...d.faq.slice(0, 1), serviceFaq(slug, d.name), ...d.faq.slice(1)];
const pillar = pillars[d.pillar];

const relAgents = d.related.agents.map((r) => agentCatalogue.find((a) => a.slug === r.id)!).filter(Boolean);
const relServices = d.related.services.map((r) => all.find((s) => s.id === r.id)!).filter(Boolean);
const relIndustries = d.related.industries.map((s) => industries.find((x) => x.slug === s)!).filter(Boolean);
const relProducts = d.related.products.map((s) => products.find((x) => x.slug === s)!).filter(Boolean);
const work = await workFor(slug);
const ways = d.engagement.map((k) => ({ key: k, ...engagementCopy[k] }));

const updated = d.updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
/** Columns that avoid a lonely last card: 4 → 2×2 or 4 across, 5 → 5 across (wide screens), otherwise 3. */
const cols = (n: number, four: 2 | 4) => (n === 4 ? four : n === 5 ? 5 : n === 2 ? 2 : 3);
const agentsTitle = d.pillar === 'ai' ? 'Or start this week with a ready-made agent.' : 'Add an AI agent to what we build.';
const agentsLead =
  d.pillar === 'ai'
    ? 'Packaged agents are set up, connected and managed for you, at a public price, and most go live in about two weeks.'
    : 'Every app we build can ship with an agent inside it. These packaged agents connect to it from day one.';
---

<BaseLayout
  seo={{ title: d.seo.title, description: d.seo.description, modifiedTime: d.updated.toISOString() }}
  schema={[service({ name: d.name, description: d.summary, path, serviceType: d.keywords.primary, offers: price.offers })]}
>
  <!-- ============ Hero ============ -->
  <section class="container sv-hero" aria-labelledby="sv-title">
    <div class="sv-copy">
      <Breadcrumbs items={[{ name: 'Services', href: '/services/' }, { name: d.name, href: path }]} />
      <p class="sv-eyebrow eyebrow">
        <span class="sv-eyebrow-icon" aria-hidden="true"><Icon name={d.icon} size={14} /></span>
        {pillar.label}
      </p>
      <h1 id="sv-title" class="sv-title">{d.h1}</h1>
      <p class="lead sv-lead">{d.summary}</p>
      <ul role="list" class="sv-facts">
        <li><Icon name="wallet" size={16} /><span><strong>{price.label}</strong></span></li>
        <li><Icon name="timer" size={16} /><span>{d.timeline}</span></li>
      </ul>
      <div class="cluster sv-ctas">
        <Button href={site.contact.bookingUrl} size="lg" icon="arrow-right" data-event="book_call" data-event-location={`service-hero-${slug}`}>Book a free strategy call</Button>
        <Button href="#pricing" size="lg" variant="glass">See pricing</Button>
      </div>
    </div>

    <aside class="snap glass-strong" aria-label={`${d.name} at a glance`}>
      <div class="snap-head">
        <span class="snap-icon" aria-hidden="true"><Icon name={d.icon} size={20} /></span>
        <div>
          <p class="snap-name">{d.name}</p>
          <p class="mono subtle snap-sub">At a glance</p>
        </div>
      </div>
      <dl class="snap-rows">
        <div class="snap-row">
          <dt>Starting at</dt>
          <dd><strong>{price.label}</strong><span class="small muted">{price.basis}</span></dd>
        </div>
        <div class="snap-row">
          <dt>Timeline</dt>
          <dd>{d.timeline}</dd>
        </div>
        <div class="snap-row">
          <dt>Ways to work</dt>
          <dd>{ways.map((w) => w.name).join(' · ')}</dd>
        </div>
        <div class="snap-row snap-wide">
          <dt>What we build</dt>
          <dd>
            <ul role="list" class="snap-chips">
              {d.offerings.slice(0, 6).map((o) => <li>{o.title}</li>)}
            </ul>
          </dd>
        </div>
        <div class="snap-row snap-wide">
          <dt>Stack</dt>
          <dd>
            <ul role="list" class="snap-chips mono">
              {d.stack.slice(0, 8).map((t) => <li>{t}</li>)}
            </ul>
          </dd>
        </div>
      </dl>
      <p class="snap-foot small muted"><span class="live-dot" aria-hidden="true"></span> NDA on request · You own 100% of the code</p>
    </aside>
  </section>

  <!-- ============ Problem ============ -->
  <Section id="problem" eyebrow="Sound familiar?" title="What usually goes wrong, and what we fix." space="tight">
    <ul role="list" class="problems" data-stagger>
      {
        d.problem.map((p) => (
          <li class="problem glass-subtle">
            <span class="p-icon" aria-hidden="true">
              <Icon name="circle-x" size={18} />
            </span>
            <p>{p}</p>
          </li>
        ))
      }
    </ul>
    <p class="best-for small">
      <span class="mono subtle">Built for</span>
      {d.bestFor.map((b) => <span class="bf-chip">{b}</span>)}
    </p>
  </Section>

  <!-- ============ What we build ============ -->
  <Section id="offerings" eyebrow="What we build" title={`${d.name}: what we deliver.`}>
    <ol role="list" class="offers" data-cols={cols(d.offerings.length, 2)} data-stagger>
      {
        d.offerings.map((o, i) => (
          <li class="offer glass-subtle spotlight">
            <span class="offer-n mono" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="h4">{o.title}</h3>
            <p class="muted small">{o.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ============ Packaged agents (cross-sell) ============ -->
  <Section id="agents" eyebrow="Packaged AI agents" title={agentsTitle} lead={agentsLead} space="tight">
    <ul role="list" class="rel-grid" data-stagger>
      {relAgents.map((a) => <AgentCard {...a} />)}
    </ul>
    <div class="sec-foot">
      <Button href="/ai-agents/" variant="glass" icon="arrow-right">See all {agentCatalogue.length} agents</Button>
    </div>
  </Section>

  <CtaBand
    title="Talk to the engineers who would build it."
    text="In a free 30-minute call we look at what you need, suggest the simplest way to build it and send a fixed quote within 24 hours."
    location={`service-mid-${slug}`}
  />

  <!-- ============ Process ============ -->
  <Section id="process" eyebrow="How it runs" title="From first call to launch, in four steps." align="center">
    <Steps steps={d.process} note={`Typical timeline: ${d.timeline.charAt(0).toLowerCase()}${d.timeline.slice(1)}. You see working software at a demo every week and pay by milestone.`} />
  </Section>

  <!-- ============ Stack · quality · how we work ============ -->
  <Section id="trust" eyebrow="Built properly" title="Modern stack, tested work, clear terms.">
    <div class="trust">
      <div class="trust-col glass-subtle" data-reveal>
        <h3 class="trust-head"><Icon name="layers" size={18} /> Stack</h3>
        <ul role="list" class="int-tags">
          {d.stack.map((t) => <li>{t}</li>)}
        </ul>
        <p class="small muted">We pick the stack for your product and your team, not ours, and document every choice.</p>
      </div>
      <div class="trust-col glass-subtle" data-reveal>
        <h3 class="trust-head"><Icon name="shield-check" size={18} /> Quality and security</h3>
        <ul role="list" class="checks">
          {
            d.quality.map((c) => (
              <li>
                <Icon name="check" size={15} strokeWidth={2.5} />
                {c}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="trust-col glass-subtle" data-reveal>
        <h3 class="trust-head"><Icon name="handshake" size={18} /> How we work</h3>
        <ul role="list" class="checks">
          {
            guarantees.map((g) => (
              <li>
                <Icon name="check" size={15} strokeWidth={2.5} />
                {g.title}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <p class="trust-note small muted">
      <Icon name="lock" size={16} />
      Our team also designs encryption hardware and network-defense products, so security is part of the design, not a final checklist.
    </p>
  </Section>

  <!-- ============ Pricing and ways to work ============ -->
  <Section id="pricing" eyebrow="Pricing" title={price.monthly ? 'A clear monthly rate per engineer.' : 'A fixed price, agreed before we start.'}>
    <div class="price-grid">
      <div class="price-card glass-strong" data-reveal="scale">
        <p class="price-name">{d.name}</p>
        <p class="price-main">
          <span class="price-from small muted">From</span>
          <span class="price-num">{price.label.replace(/^From /, '')}</span>
        </p>
        <p class="small muted">{price.basis.charAt(0).toUpperCase()}{price.basis.slice(1)}</p>
        <h3 class="price-inc-head mono">What's included</h3>
        <ul role="list" class="checks">
          {
            d.includes.map((c) => (
              <li>
                <Icon name="check" size={15} strokeWidth={2.5} />
                {c}
              </li>
            ))
          }
        </ul>
        <div class="price-ctas">
          <Button href={site.contact.bookingUrl} block icon="arrow-right" data-event="book_call" data-event-location={`service-pricing-${slug}`}>Book a free strategy call</Button>
          <Button href="/contact/#quote" block variant="glass" data-event="quote_click" data-event-location={`service-pricing-${slug}`}>Get a quote in 24h</Button>
        </div>
      </div>

      <div class="price-side">
        <p class="eyebrow ways-head">Ways to work with us</p>
        {
          ways.map((w) => (
            <div class="way glass-subtle" data-reveal>
              <span class="way-icon" aria-hidden="true">
                <Icon name={w.icon} size={18} />
              </span>
              <div>
                <h3 class="h4 way-name">{w.name}</h3>
                <p class="small muted">{w.text}</p>
                <p class="way-price mono">{w.price}</p>
              </div>
            </div>
          ))
        }
        <ul role="list" class="promises small">
          <li><Icon name="file-signature" size={15} /> NDA on request from the first call</li>
          <li><Icon name="key-round" size={15} /> You own 100% of the code and IP</li>
          <li><Icon name="life-buoy" size={15} /> 30 days of post-launch support</li>
        </ul>
      </div>
    </div>
  </Section>

  <!-- ============ Related case studies (anonymous, via getWork) ============ -->
  {
    work.length > 0 && (
      <Section id="work" eyebrow="Our work" title="Projects like this we have shipped." lead="Client names stay private by default. On a call we walk you through the details, under NDA." space="tight">
        <ul role="list" class="work-grid" data-stagger>
          {work.map((w) => (
            <CaseCard entry={w} />
          ))}
        </ul>
        <div class="sec-foot">
          <Button href="/work/" variant="glass" icon="arrow-right">See all case studies</Button>
        </div>
      </Section>
    )
  }

  <!-- ============ Own products (deep tech) ============ -->
  {
    relProducts.length > 0 && (
      <Section id="products" eyebrow="Our own products" title="Built and shipped in-house." space="tight">
        <ul role="list" class="prod-grid" data-stagger>
          {relProducts.map((p) => (
            <li class="prod glass-subtle spotlight lift">
              <a class="card-cover" href={`/products/${p.slug}/`} aria-hidden="true" tabindex="-1" />
              <span class="prod-icon" aria-hidden="true">
                <Icon name={p.icon} size={20} />
              </span>
              <h3 class="h4">
                <a href={`/products/${p.slug}/`}>{p.name}</a>
              </h3>
              <p class="muted small">{p.line}</p>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <!-- ============ Comparison (optional Markdown body) ============ -->
  {
    hasBody && (
      <Section id="compare" width="narrow" space="tight">
        <div class="prose sv-body glass-subtle" data-reveal>
          <Content />
        </div>
      </Section>
    )
  }

  <!-- ============ FAQ ============ -->
  <Section id="faq" eyebrow="FAQ" title={`${d.name}: common questions.`} width="narrow" align="center">
    <Accordion items={faqs} schema name="service-faq" />
    <p class="faq-more small muted">
      Something else? <a class="link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a> or <a class="link" href={site.contact.bookingUrl}>book a call</a>.
      <span class="updated mono">Updated {updated}</span>
    </p>
  </Section>

  <!-- ============ Related services and industries ============ -->
  {
    relServices.length > 0 && (
      <Section id="related" eyebrow="Related services" title="Often combined with." space="tight">
        <ul role="list" class="rel-grid" data-stagger>
          {relServices.map((s) => (
            <ServiceCard slug={s.id} name={s.data.name} line={s.data.tagline} icon={s.data.icon} />
          ))}
        </ul>
        {relIndustries.length > 0 && (
          <p class="rel-more small">
            <span class="mono subtle">Industries</span>
            {relIndustries.map((s) => (
              <IndTag class="rel-chip glass-chip press" href={industriesLive ? `/industries/${s.slug}/` : undefined}>
                <Icon name={s.icon} size={14} />
                {s.name}
              </IndTag>
            ))}
          </p>
        )}
        <div class="sec-foot">
          <Button href="/services/" variant="glass" icon="arrow-right">See all {all.length} services</Button>
        </div>
      </Section>
    )
  }

  <!-- ============ Guides (S10): posts that link to this page ============ -->
  <RelatedReading />

  <CtaBand title="Tell us what you need. Get a fixed quote within 24 hours." location={`service-final-${slug}`} />
</BaseLayout>

<style>
  /* ---------- hero ---------- */
  .sv-hero {
    display: grid;
    align-items: center;
    gap: clamp(2rem, 1.5rem + 3vw, 4rem);
    padding-block: calc(var(--header-h) + clamp(1.25rem, 0.5rem + 3vw, 3rem)) clamp(2rem, 1rem + 3vw, 4rem);
  }
  @media (min-width: 64rem) {
    .sv-hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      min-height: min(100svh, 52rem);
    }
  }
  .sv-copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .sv-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .sv-eyebrow-icon {
    display: grid;
    place-items: center;
    inline-size: 1.6rem;
    block-size: 1.6rem;
    border-radius: 0.5rem;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
  }
  .sv-title {
    font-size: clamp(2.25rem, 1.5rem + 3.2vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    font-weight: 680;
    max-width: 17ch;
    text-wrap: balance;
  }
  .sv-lead {
    max-width: 58ch;
  }
  @media (max-width: 40rem) {
    .sv-lead {
      font-size: var(--step-0);
    }
  }
  .sv-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--step--1);
  }
  .sv-facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .sv-facts :global(.icon) {
    flex: none;
    color: var(--accent);
  }
  .sv-facts strong {
    font-weight: 620;
  }

  /* ---------- snapshot panel ---------- */
  .snap {
    --glass-radius: var(--radius-xl);
    display: grid;
    gap: var(--space-4);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    inline-size: 100%;
    max-inline-size: 32rem;
    justify-self: center;
  }
  @media (min-width: 64rem) {
    .snap {
      justify-self: end;
    }
  }
  .snap > * {
    position: relative;
    z-index: 2;
  }
  .snap-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block-end: var(--space-4);
    border-block-end: 1px solid var(--border);
  }
  .snap-icon {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 0.95rem;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
    box-shadow: var(--btn-primary-glow);
  }
  .snap-name {
    font-weight: 640;
    font-size: var(--step-0);
  }
  .snap-sub {
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }
  .snap-rows {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  .snap-row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    font-size: var(--step--1);
  }
  .snap-row dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
  .snap-row dd {
    display: grid;
    gap: 0.15rem;
    margin: 0;
  }
  .snap-row strong {
    font-size: var(--step-1);
    font-weight: 680;
    letter-spacing: -0.02em;
  }
  .snap-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .snap-chips li {
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    background: color-mix(in srgb, var(--fg) 8%, transparent);
  }
  .snap-chips.mono li {
    font-size: 0.6875rem;
    color: var(--fg-muted);
  }
  @media (max-width: 30rem) {
    .snap-row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .snap-wide:first-of-type {
      display: none;
    }
  }
  .snap-foot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--border);
  }
  .live-dot {
    inline-size: 0.45rem;
    block-size: 0.45rem;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgb(34 197 94 / 0.22);
  }

  /* ---------- problem ---------- */
  .problems {
    display: grid;
    gap: var(--space-3);
  }
  @media (min-width: 52rem) {
    .problems {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .problem {
    --glass-radius: var(--radius-md);
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-4) var(--space-5);
  }
  .problem > * {
    position: relative;
    z-index: 2;
  }
  .p-icon {
    flex: none;
    margin-block-start: 0.15rem;
    color: var(--fg-subtle);
  }
  .best-for,
  .rel-more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: var(--space-5);
  }
  .best-for .mono,
  .rel-more .mono {
    margin-inline-end: var(--space-2);
    font-size: 0.75rem;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }
  .bf-chip {
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    color: var(--fg-muted);
    background: color-mix(in srgb, var(--fg) 7%, transparent);
  }

  /* ---------- offerings: columns chosen from the item count (no lonely last card) ---------- */
  .offers {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }
  @media (min-width: 64rem) {
    [data-cols] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    [data-cols='2'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    [data-cols='4'] {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 72rem) {
    [data-cols='5'] {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .offer {
    --glass-radius: var(--radius-lg);
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5);
  }
  .offer > * {
    position: relative;
    z-index: 2;
  }
  .offer-n {
    font-size: 0.75rem;
    color: var(--accent);
  }

  /* ---------- card grids ---------- */
  .rel-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  @media (max-width: 40rem) {
    .rel-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }
  }
  .work-grid {
    display: grid;
    gap: var(--space-5);
