---
/** Numbered process (01–04), e.g. "How it works". Glass cards joined by a gradient line on wide screens. */
interface Step {
  title: string;
  body: string;
  meta?: string | undefined;
}
interface Props {
  steps: Step[];
  note?: string;
}
const { steps, note } = Astro.props;
---

<div class="steps-wrap">
  <ol role="list" class="steps" data-stagger style={`--n:${steps.length}`}>
    {
      steps.map((s, i) => (
        <li class="step glass-subtle spotlight">
          <span class="step-num mono" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="h4">{s.title}</h3>
          <p class="muted">{s.body}</p>
          {s.meta && <p class="step-meta mono small">{s.meta}</p>}
        </li>
      ))
    }
  </ol>
  {note && <p class="steps-note small"><span class="dot" aria-hidden="true"></span>{note}</p>}
</div>

<style>
  .steps {
    position: relative;
    display: grid;
    gap: var(--space-4);
    counter-reset: step;
  }
  @media (min-width: 56rem) {
    .steps {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    }
    .steps::before {
      content: '';
      position: absolute;
      inset: 2.6rem 6% auto;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--brand-orange), var(--brand-magenta), var(--brand-violet), transparent);
      opacity: 0.55;
    }
  }
  .step {
    --glass-radius: var(--radius-lg);
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-5);
  }
  .step > * {
    position: relative;
    z-index: 2;
  }
  .step-num {
    display: inline-grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: var(--radius-pill);
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
    font-weight: 600;
    font-size: 0.9375rem;
    box-shadow: var(--btn-primary-glow);
  }
  .step-meta {
    color: var(--accent);
  }
  .steps-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-block-start: var(--space-5);
    color: var(--fg-muted);
  }
  .dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 4px rgb(34 197 94 / 0.2);
  }
</style>
