---
/**
 * Scripted, looping agent preview (D19): the homepage hero console and the "See it work" panel on every agent page.
 * Plain HTML/CSS, so it is crisp, indexable and light. A small script plays the lines one by one (agent replies get a
 * typing state), pauses when off-screen or when the tab is hidden, and restarts the loop. Without JS or with reduced
 * motion, the whole conversation is shown. The first `initial` lines are visible in the HTML so the first paint
 * already shows a conversation. It always carries a caption saying it is scripted, with a fictional business.
 *
 *   <AgentDemo {...script} id="demo" />
 */
import Icon from '@/components/Icon.astro';
import { defaultWait, type DemoScript } from '@/lib/demo';

interface Props extends DemoScript {
  /** Unique per page (used for the caption id). */
  id?: string;
  /** SVG refraction lens (hero only, D14). */
  lens?: boolean;
  /** How many lines are visible before the script starts. */
  initial?: number;
  class?: string;
}
const { title, status, icon = 'bot', tools, lines, caption, id = 'demo', lens = false, initial = 2, class: className } = Astro.props;
const capId = `${id}-cap`;
const wait = (l: (typeof lines)[number]) => l.wait ?? defaultWait[l.kind];
---

<figure class:list={['console glass-strong', { lens }, className]} data-console aria-labelledby={capId}>
  <div class="con-head">
    <span class="con-avatar" aria-hidden="true"><Icon name={icon} size={16} /></span>
    <div class="con-id">
      <p class="con-name">{title}</p>
      <p class="con-status mono"><span class="live-dot" aria-hidden="true"></span>{status}</p>
    </div>
    <ul role="list" class="con-tools" aria-label="Connected tools">
      {
        tools.map((t) => (
          <li>
            <Icon name={t.icon} size={13} /> {t.label}
          </li>
        ))
      }
    </ul>
  </div>

  <ol role="list" class="con-feed">
    {
      lines.map((l, i) => {
        const on = i < initial ? 'on' : undefined;
        switch (l.kind) {
          case 'in':
            return (
              <li class="line in" data-state={on} data-wait={wait(l)}>
                <span class="who mono">{l.who}</span>
                <p class="bubble">{l.text}</p>
              </li>
            );
          case 'out':
            return (
              <li class="line out" data-state={on} data-typing={on ? undefined : ''} data-wait={wait(l)}>
                <span class="who mono">{l.who ?? 'Agent'}</span>
                <p class="bubble">
                  <span class="txt">{l.text}</span>
                  <span class="dots" aria-hidden="true">
                    <i />
                    <i />
                    <i />
                  </span>
                </p>
              </li>
            );
          case 'sys':
            return (
              <li class="line sys" data-state={on} data-wait={wait(l)}>
                <Icon name={l.icon ?? 'sparkles'} size={14} />
                <span class="mono">{l.label}</span>
                <span>{l.text}</span>
              </li>
            );
          case 'tool':
            return (
              <li class="line tool" data-state={on} data-wait={wait(l)}>
                <Icon name={l.icon ?? 'terminal'} size={14} />
                {l.calls.map((c) => (
                  <code>{c}</code>
                ))}
                {l.result && <span class="res">{l.result}</span>}
              </li>
            );
          case 'gate':
            return (
              <li class="line gate" data-state={on} data-wait={wait(l)}>
                <Icon name={l.icon ?? 'user-check'} size={14} />
                <span class="mono">approval</span>
                <span>{l.text}</span>
              </li>
            );
          case 'done':
            return (
              <li class="line done" data-state={on} data-wait={wait(l)}>
                <Icon name={l.icon ?? 'badge-check'} size={15} />
                <span>{l.text}</span>
              </li>
            );
        }
      })
    }
  </ol>

  <figcaption id={capId} class="con-foot mono">{caption}</figcaption>
</figure>

<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-console]').forEach((root) => {
      const lines = Array.from(root.querySelectorAll<HTMLElement>('.line'));
      const initial = lines.filter((l) => l.dataset.state === 'on').length;
      let i = initial;
      let timer = 0;
      let running = false;
      let inView = false;
      const wait = (l: HTMLElement) => Number(l.dataset.wait ?? 1200);
      const after = (ms: number, fn: () => void) => (timer = window.setTimeout(fn, ms));
      // Replies that start visible skip the typing state on the first pass; give it back for later loops.
      root.querySelectorAll<HTMLElement>('.line.out').forEach((l) => l.setAttribute('data-typing', ''));
      root.setAttribute('data-play', '');

      const next = (): void => {
        if (!running) return;
        if (i >= lines.length) {
          root.setAttribute('data-fade', '');
          after(650, () => {
            lines.forEach((l) => l.removeAttribute('data-state'));
            root.removeAttribute('data-fade');
            i = 0;
            after(500, next);
          });
          return;
        }
        const l = lines[i++]!;
        if (l.hasAttribute('data-typing')) {
          l.dataset.state = 'typing';
          after(1000, () => {
            l.dataset.state = 'on';
            after(wait(l), next);
          });
        } else {
          l.dataset.state = 'on';
          after(wait(l), next);
        }
      };

      const sync = () => {
        const play = inView && !document.hidden;
        if (play && !running) {
          running = true;
          after(i === initial ? 900 : 300, next);
        } else if (!play && running) {
          running = false;
          clearTimeout(timer);
          root.querySelectorAll<HTMLElement>('[data-state="typing"]').forEach((l) => (l.dataset.state = 'on'));
        }
      };
      new IntersectionObserver(([e]) => {
        inView = !!e?.isIntersecting;
        sync();
      }).observe(root);
      document.addEventListener('visibilitychange', sync);
    });
  }
</script>

<style>
  .console {
    --glass-radius: var(--radius-xl);
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: clamp(1rem, 0.7rem + 1vw, 1.5rem);
    inline-size: 100%;
    max-inline-size: 31rem;
  }
  .console > * {
    position: relative;
    z-index: 2;
  }

  /* ---- head ---- */
  .con-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-block-end: var(--space-4);
    border-block-end: 1px solid var(--border);
  }
  .con-avatar {
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border-radius: 0.8rem;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
    box-shadow: var(--btn-primary-glow);
  }
  .con-id {
    display: grid;
    gap: 0.1rem;
    margin-inline-end: auto;
  }
  .con-name {
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.2;
  }
  .con-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--fg-muted);
  }
  .live-dot {
    inline-size: 0.45rem;
    block-size: 0.45rem;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgb(34 197 94 / 0.22);
  }
  @media (prefers-reduced-motion: no-preference) {
    .live-dot {
      animation: pulse 2.2s ease-in-out infinite;
    }
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 6px rgb(34 197 94 / 0);
    }
  }
  .con-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .con-tools li {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
    font-size: 0.6875rem;
    font-weight: 540;
    color: var(--fg-muted);
    background: color-mix(in srgb, var(--fg) 7%, transparent);
  }

  /* ---- feed ---- */
  .con-feed {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }
  .line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .who {
    flex-basis: 100%;
    font-size: 0.6875rem;
    color: var(--fg-subtle);
    letter-spacing: 0.02em;
  }
  .bubble {
    position: relative;
    max-inline-size: 88%;
    padding: 0.55rem 0.8rem;
    border-radius: 1rem 1rem 1rem 0.3rem;
    background: color-mix(in srgb, var(--fg) 9%, transparent);
  }
  .out {
    justify-content: flex-end;
  }
  .out .who {
    text-align: end;
  }
  .out .bubble {
    border-radius: 1rem 1rem 0.3rem 1rem;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
    font-weight: 500;
  }
  .sys,
  .tool,
  .gate {
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    color: var(--fg-muted);
    background: color-mix(in srgb, var(--fg) 4%, transparent);
    box-shadow: inset 0 0 0 1px var(--border);
  }
  .sys :global(.icon),
  .tool :global(.icon) {
    color: var(--accent);
  }
  .sys .mono,
  .gate .mono {
    color: var(--fg);
    font-size: 0.75rem;
  }
  .tool code {
    font-size: 0.75rem;
    color: var(--fg);
    overflow-wrap: anywhere;
  }
  .res {
    margin-inline-start: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #4ade80;
  }
  :global([data-theme='light']) .res {
    color: #15803d;
  }
  /* approval gate: amber, so the human checkpoint stands out */
  .gate {
    color: var(--fg);
    background: rgb(245 158 11 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(245 158 11 / 0.4);
  }
  .gate :global(.icon) {
    color: #fbbf24;
  }
  :global([data-theme='light']) .gate :global(.icon) {
    color: #b45309;
  }
  .done {
    gap: 0.5rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    font-weight: 540;
    color: var(--fg);
    background: rgb(34 197 94 / 0.12);
    box-shadow: inset 0 0 0 1px rgb(34 197 94 / 0.35);
  }
  .done :global(.icon) {
    flex: none;
    color: #4ade80;
  }
  :global([data-theme='light']) .done :global(.icon) {
    color: #15803d;
  }
  .done > span {
    flex: 1;
  }

  .con-foot {
    font-size: 0.6875rem;
    color: var(--fg-subtle);
    text-align: center;
    letter-spacing: 0.02em;
  }

  /* ---- playback (only once the script has taken over; space is reserved, so nothing shifts) ---- */
  .dots {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .console[data-play] .line {
      transition:
        opacity 420ms var(--ease-out),
        translate 420ms var(--ease-out);
    }
    .console[data-play] .line:not([data-state]) {
      opacity: 0;
      translate: 0 0.5rem;
    }
    .console[data-fade] .line {
      opacity: 0;
    }
    .line[data-state='typing'] .txt {
      visibility: hidden;
    }
    .line[data-state='typing'] .dots {
      position: absolute;
      inset-block: 0;
      inset-inline-end: 0.8rem;
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }
    .dots i {
      inline-size: 0.35rem;
      block-size: 0.35rem;
      border-radius: 50%;
      background: currentColor;
      opacity: 0.4;
      animation: blink 1s infinite;
    }
    .dots i:nth-child(2) {
      animation-delay: 0.15s;
    }
    .dots i:nth-child(3) {
      animation-delay: 0.3s;
    }
  }
  @keyframes blink {
    30% {
      opacity: 1;
      translate: 0 -2px;
    }
  }

  @media (max-width: 30rem) {
    .con-tools {
      inline-size: 100%;
    }
    .bubble {
      max-inline-size: 94%;
    }
  }
</style>
