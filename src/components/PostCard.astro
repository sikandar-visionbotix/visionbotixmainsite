---
/**
 * Post card (S10): /resources/ hub, tag and author pages, "Keep reading". Same anatomy as the other cards: the whole
 * card is one link via a cover anchor, the heading link carries the accessible name.
 */
import Icon from '@/components/Icon.astro';
import { formats } from '@/data/resources';
import { readingMinutes, postDate, filled, cardTag, type PostEntry } from '@/lib/posts';

interface Props {
  post: PostEntry;
  heading?: 'h2' | 'h3';
  as?: 'li' | 'div';
  /** Larger card with the summary (the hub's featured row). */
  feature?: boolean;
}
const { post, heading: H = 'h3', as: Tag = 'li', feature = false } = Astro.props;
const d = post.data;
const href = `/resources/${post.id}/`;
---

<Tag class:list={['post-card glass-subtle spotlight lift', { feature }]}>
  <a class="card-cover" href={href} aria-hidden="true" tabindex="-1"></a>
  <p class="post-kicker mono">
    <span>{formats[d.format]}</span>
    <span aria-hidden="true">·</span>
    <span>{cardTag(d)}</span>
  </p>
  <H class="post-title"><a href={href}>{d.title}</a></H>
  <p class="post-excerpt muted small">{filled(feature ? d.summary : d.excerpt)}</p>
  <p class="post-meta subtle mono">
    <span><Icon name="clock" size={13} /> {readingMinutes(post)} min read</span>
    <span>Updated <time datetime={d.updated.toISOString().slice(0, 10)}>{postDate(d.updated)}</time></span>
  </p>
</Tag>

<style>
  .post-card {
    --glass-radius: var(--radius-lg);
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-5);
  }
  .post-card > :not(.card-cover) {
    position: relative;
    z-index: 2;
  }
  .card-cover {
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
  }
  .post-card:has(.post-title a:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .post-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.72rem;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
  }
  .post-title {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-heading);
    font-weight: 620;
    text-wrap: balance;
  }
  .feature .post-title {
    font-size: var(--step-2);
  }
  .post-title a {
    text-decoration: none;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin-block-start: auto;
    font-size: 0.75rem;
  }
  .post-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
</style>
