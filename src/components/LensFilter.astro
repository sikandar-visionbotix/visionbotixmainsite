---
/**
 * SVG displacement filter for the Chromium-only "lens" refraction (`.lens` + html[data-lens], see glass.css).
 * Render once per page that has a `.lens` element (the homepage hero). The displacement map is a soft radial
 * gradient, so the edges of the panel bend the backdrop like the rim of a glass lens.
 */
interface Props {
  scale?: number;
}
const { scale = 38 } = Astro.props;
const map = `data:image/svg+xml,${encodeURIComponent(
  `<svg xmlns="http://www.w3.org/2000/svg" width="256" height="256"><defs><radialGradient id="g" cx="50%" cy="50%" r="65%"><stop offset="55%" stop-color="rgb(128,128,128)"/><stop offset="100%" stop-color="rgb(255,0,128)"/></radialGradient><linearGradient id="h"><stop offset="0" stop-color="rgb(0,128,128)"/><stop offset="1" stop-color="rgb(255,128,128)"/></linearGradient></defs><rect width="256" height="256" fill="url(#h)"/><rect width="256" height="256" fill="url(#g)" opacity=".55"/></svg>`,
)}`;
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <filter id="vbx-lens" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
    <feImage href={map} x="0" y="0" width="100%" height="100%" preserveAspectRatio="none" result="map"></feImage>
    <feGaussianBlur in="map" stdDeviation="6" result="soft"></feGaussianBlur>
    <feDisplacementMap in="SourceGraphic" in2="soft" scale={scale} xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
  </filter>
</svg>
