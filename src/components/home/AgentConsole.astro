---
/**
 * Hero showpiece: a scripted, looping "agent console" (PLAN §4). Plain HTML/CSS, so it is crisp, indexable and light.
 * A small script plays the lines one by one (with a typing state for agent replies), pauses when off-screen or when
 * the tab is hidden, and restarts the loop. Without JS or with reduced motion, the whole conversation is shown.
 * The first two lines are visible in the HTML so the first paint already shows a conversation.
 * It is a demo with a fictional business, and it says so in the caption.
 */
import Icon from '@/components/Icon.astro';
---

<figure class="console glass-strong lens" data-console aria-labelledby="console-cap">
  <div class="con-head">
    <span class="con-avatar" aria-hidden="true"><Icon name="headset" size={16} /></span>
    <div class="con-id">
      <p class="con-name">Receptionist agent</p>
      <p class="con-status mono"><span class="live-dot" aria-hidden="true"></span>Live · after hours</p>
    </div>
    <ul role="list" class="con-tools" aria-label="Connected tools">
      <li><Icon name="whatsapp" size={13} /> WhatsApp</li>
      <li><Icon name="calendar" size={13} /> Calendar</li>
      <li><Icon name="database" size={13} /> CRM</li>
    </ul>
  </div>

  <ol role="list" class="con-feed">
    <li class="line in" data-state="on" data-wait="1300">
      <span class="who mono">WhatsApp · 21:47</span>
      <p class="bubble">Hi! Any chance of a cleaning this Saturday morning?</p>
    </li>
    <li class="line sys" data-state="on" data-wait="1100">
      <Icon name="sparkles" size={14} />
      <span class="mono">intent</span><span>new booking · new patient</span>
    </li>
    <li class="line tool" data-wait="1200">
      <Icon name="calendar-clock" size={14} />
      <code>calendar.find_slots("Sat AM")</code><span class="res">09:30, 11:00</span>
    </li>
    <li class="line out" data-typing data-wait="1700">
      <span class="who mono">Agent</span>
      <p class="bubble"><span class="txt">I can do 09:30 or 11:00 this Saturday. Which suits you?</span><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span></p>
    </li>
    <li class="line in" data-wait="1100">
      <span class="who mono">WhatsApp · 21:48</span>
      <p class="bubble">11:00 please</p>
    </li>
    <li class="line tool" data-wait="1200">
      <Icon name="circle-check" size={14} />
      <code>calendar.book("Sat 11:00")</code><code>crm.upsert(contact)</code>
    </li>
    <li class="line out" data-typing data-wait="1400">
      <span class="who mono">Agent</span>
      <p class="bubble"><span class="txt">You're booked for Saturday at 11:00. I'll send a reminder the day before.</span><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span></p>
    </li>
    <li class="line done" data-wait="4200">
      <Icon name="badge-check" size={15} />
      <span>Booked after hours · logged to CRM · reminder set · no human needed</span>
    </li>
  </ol>

  <figcaption id="console-cap" class="con-foot mono">Scripted demo · a fictional dental clinic</figcaption>
</figure>

<script>
  const root = document.querySelector<HTMLElement>('[data-console]');
  if (root && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const lines = Array.from(root.querySelectorAll<HTMLElement>('.line'));
    const initial = lines.filter((l) => l.dataset.state === 'on').length;
    let i = initial;
    let timer = 0;
    let running = false;
    let inView = false;
    const wait = (l: HTMLElement) => Number(l.dataset.wait ?? 1200);
    const after = (ms: number, fn: () => void) => (timer = window.setTimeout(fn, ms));
    root.setAttribute('data-play', '');

    const next = (): void => {
      if (!running) return;
      if (i >= lines.length) {
        root.setAttribute('data-fade', '');
        after(650, () => {
          lines.forEach((l) => l.removeAttribute('data-state'));
          root.removeAttribute('data-fade');
          i = 0;
          after(500, next);
        });
        return;
      }
      const l = lines[i++]!;
      if (l.hasAttribute('data-typing')) {
        l.dataset.state = 'typing';
        after(1000, () => {
          l.dataset.state = 'on';
          after(wait(l), next);
        });
      } else {
        l.dataset.state = 'on';
        after(wait(l), next);
      }
    };

    const sync = () => {
      const play = inView && !document.hidden;
      if (play && !running) {
        running = true;
        after(i === initial ? 900 : 300, next);
      } else if (!play && running) {
        running = false;
        clearTimeout(timer);
        root.querySelectorAll<HTMLElement>('[data-state="typing"]').forEach((l) => (l.dataset.state = 'on'));
      }
    };
    new IntersectionObserver(([e]) => {
      inView = !!e?.isIntersecting;
      sync();
    }).observe(root);
    document.addEventListener('visibilitychange', sync);
  }
</script>

<style>
  .console {
    --glass-radius: var(--radius-xl);
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: clamp(1rem, 0.7rem + 1vw, 1.5rem);
    inline-size: 100%;
    max-inline-size: 31rem;
  }
  .console > * {
    position: relative;
    z-index: 2;
  }

  /* ---- head ---- */
  .con-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-block-end: var(--space-4);
    border-block-end: 1px solid var(--border);
  }
  .con-avatar {
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border-radius: 0.8rem;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
    box-shadow: var(--btn-primary-glow);
  }
  .con-id {
    display: grid;
    gap: 0.1rem;
    margin-inline-end: auto;
  }
  .con-name {
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.2;
  }
  .con-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--fg-muted);
  }
  .live-dot {
    inline-size: 0.45rem;
    block-size: 0.45rem;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgb(34 197 94 / 0.22);
  }
  @media (prefers-reduced-motion: no-preference) {
    .live-dot {
      animation: pulse 2.2s ease-in-out infinite;
    }
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 6px rgb(34 197 94 / 0);
    }
  }
  .con-tools {
    display: flex;
    gap: 0.35rem;
  }
  .con-tools li {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
    font-size: 0.6875rem;
    font-weight: 540;
    color: var(--fg-muted);
    background: color-mix(in srgb, var(--fg) 7%, transparent);
  }

  /* ---- feed ---- */
  .con-feed {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }
  .line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .who {
    flex-basis: 100%;
    font-size: 0.6875rem;
    color: var(--fg-subtle);
    letter-spacing: 0.02em;
  }
  .bubble {
    position: relative;
    max-inline-size: 88%;
    padding: 0.55rem 0.8rem;
    border-radius: 1rem 1rem 1rem 0.3rem;
    background: color-mix(in srgb, var(--fg) 9%, transparent);
  }
  .out {
    justify-content: flex-end;
  }
  .out .who {
    text-align: end;
  }
  .out .bubble {
    border-radius: 1rem 1rem 0.3rem 1rem;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
    font-weight: 500;
  }
  .sys,
  .tool {
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    color: var(--fg-muted);
    background: color-mix(in srgb, var(--fg) 4%, transparent);
    box-shadow: inset 0 0 0 1px var(--border);
  }
  .sys :global(.icon),
  .tool :global(.icon) {
    color: var(--accent);
  }
  .sys .mono {
    color: var(--fg);
    font-size: 0.75rem;
  }
  .tool code {
    font-size: 0.75rem;
    color: var(--fg);
  }
  .res {
    margin-inline-start: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #4ade80;
  }
  :global([data-theme='light']) .res {
    color: #15803d;
  }
  .done {
    gap: 0.5rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    font-weight: 540;
    color: var(--fg);
    background: rgb(34 197 94 / 0.12);
    box-shadow: inset 0 0 0 1px rgb(34 197 94 / 0.35);
  }
  .done :global(.icon) {
    color: #4ade80;
  }
  :global([data-theme='light']) .done :global(.icon) {
    color: #15803d;
  }

  .con-foot {
    font-size: 0.6875rem;
    color: var(--fg-subtle);
    text-align: center;
    letter-spacing: 0.02em;
  }

  /* ---- playback (only once the script has taken over; space is reserved, so nothing shifts) ---- */
  .dots {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .console[data-play] .line {
      transition:
        opacity 420ms var(--ease-out),
        translate 420ms var(--ease-out);
    }
    .console[data-play] .line:not([data-state]) {
      opacity: 0;
      translate: 0 0.5rem;
    }
    .console[data-fade] .line {
      opacity: 0;
    }
    .line[data-state='typing'] .txt {
      visibility: hidden;
    }
    .line[data-state='typing'] .dots {
      position: absolute;
      inset-block: 0;
      inset-inline-end: 0.8rem;
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }
    .dots i {
      inline-size: 0.35rem;
      block-size: 0.35rem;
      border-radius: 50%;
      background: currentColor;
      opacity: 0.4;
      animation: blink 1s infinite;
    }
    .dots i:nth-child(2) {
      animation-delay: 0.15s;
    }
    .dots i:nth-child(3) {
      animation-delay: 0.3s;
    }
  }
  @keyframes blink {
    30% {
      opacity: 1;
      translate: 0 -2px;
    }
  }

  @media (max-width: 30rem) {
    .con-tools {
      inline-size: 100%;
    }
    .bubble {
      max-inline-size: 94%;
    }
  }
</style>
