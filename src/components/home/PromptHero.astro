---
/**
 * Prompt-first hero (S5, owner request: the Wakeel pattern on visionbotix.com). The visitor describes what they want in
 * plain words (or by voice), and gets "Understood as" signals plus the 2–3 best-fitting agents or services with
 * their "from" prices, then carries the brief into the quote form. Matching runs in the browser against a
 * build-time index (src/lib/match.ts); nothing leaves the page unless the visitor sends the brief. Without JS the
 * form simply opens /contact/ with the brief. S7 can swap the matcher for the live LLM concierge.
 */
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import { site } from '@/data/site';
import { buildMatchIndex } from '@/lib/match';

const index = await buildMatchIndex();
const chips = [
  { label: 'Answer every call', text: 'Answer our phone calls 24/7 and book appointments into our calendar' },
  { label: 'Follow up every lead', text: 'Follow up every new lead within a minute and book a sales call' },
  { label: 'WhatsApp orders', text: 'Reply to customers on WhatsApp and give order status for our online store' },
  { label: 'Automate invoices', text: 'Read supplier invoices from email and enter them into our accounting system' },
  { label: 'Build a mobile app', text: 'Build an iOS and Android app for our customers with an AI assistant inside' },
  { label: 'Launch a SaaS MVP', text: 'Build a SaaS MVP for our startup idea and launch it in a few weeks' },
];
const examples = [
  'Answer our clinic’s calls after hours and book appointments…',
  'Turn supplier invoices into entries in our accounting system…',
  'Build a marketplace app with AI search, like Wakeel…',
  'Reply to Instagram and WhatsApp messages in our brand voice…',
];
---

<div class="ph" data-prompt>
  <form class="ph-box glass-strong" action="/contact/" method="get" data-ph-form>
    <label for="ph-input" class="visually-hidden">Describe what you want an AI agent or an app to do for your business</label>
    <div class="ph-row">
      <span class="ph-spark" aria-hidden="true"><Icon name="sparkles" size={18} /></span>
      <textarea id="ph-input" name="brief" rows="2" maxlength="600" placeholder={examples[0]} autocomplete="off" enterkeyhint="send" data-ph-input
      ></textarea>
    </div>
    <div class="ph-bar">
      <span class="ph-hint mono" aria-hidden="true">Describe it in your own words · Enter ↵</span>
      <button type="button" class="ph-mic press" hidden data-ph-mic aria-pressed="false" aria-label="Speak instead of typing">
        <Icon name="mic" size={18} />
      </button>
      <button type="submit" class="ph-send press" aria-label="Show my plan" data-event="prompt_submit" data-event-location="hero">
        <Icon name="arrow-right" size={18} strokeWidth={2.25} />
      </button>
    </div>
  </form>

  <ul role="list" class="ph-chips" aria-label="Examples">
    {
      chips.map((c) => (
        <li>
          <button type="button" class="ph-chip glass-chip press" data-fill={c.text}>
            {c.label}
          </button>
        </li>
      ))
    }
  </ul>

  <section class="ph-result glass-subtle" data-ph-result hidden aria-labelledby="ph-result-title" tabindex="-1">
    <h2 id="ph-result-title" class="visually-hidden">Your plan</h2>
    <p class="ph-label mono"><Icon name="scan-search" size={13} /> Understood as</p>
    <ul role="list" class="ph-sig" data-ph-sig></ul>
    <p class="ph-label mono"><Icon name="badge-check" size={13} /> Best fit</p>
    <ol role="list" class="ph-matches" data-ph-matches></ol>
    <div class="ph-actions cluster">
      <Button href="/contact/#quote" size="sm" icon="arrow-right" data-ph-quote data-event="prompt_quote" data-event-location="hero">Send this brief, get a quote in 24h</Button>
      <Button href={site.contact.bookingUrl} size="sm" variant="glass" data-event="book_call" data-event-location="hero-prompt">Book a call</Button>
    </div>
    <p class="ph-note small subtle">Matched in your browser. Nothing is sent until you choose to send it.</p>
  </section>

  <p class="ph-alt small muted">
    Prefer to talk? <a class="link" href={site.contact.bookingUrl} data-event="book_call" data-event-location="hero">Book a free strategy call</a> · <a class="link" href="/pricing/" data-event="pricing_click" data-event-location="hero">See pricing</a>
  </p>
</div>

<script type="application/json" id="ph-index" set:html={JSON.stringify({ ...index, examples })} />

<script>
  interface Item {
    t: 'a' | 's';
    name: string;
    line: string;
    href: string;
    price: string | null;
    kw: string;
  }
  interface Index {
    items: Item[];
    industries: { name: string; kw: string }[];
    examples: string[];
  }

  const root = document.querySelector<HTMLElement>('[data-prompt]');
  const raw = document.getElementById('ph-index')?.textContent;
  if (root && raw) {
    const idx: Index = JSON.parse(raw);
    const form = root.querySelector<HTMLFormElement>('[data-ph-form]')!;
    const input = root.querySelector<HTMLTextAreaElement>('[data-ph-input]')!;
    const result = root.querySelector<HTMLElement>('[data-ph-result]')!;
    const sigList = root.querySelector<HTMLElement>('[data-ph-sig]')!;
    const matchList = root.querySelector<HTMLElement>('[data-ph-matches]')!;
    const quote = root.querySelector<HTMLAnchorElement>('[data-ph-quote]')!;
    const mic = root.querySelector<HTMLButtonElement>('[data-ph-mic]')!;

    const STOP = new Set(
      'a an the and or but for to of in on at by with from into via my our we i me us you your is are am be been can could need needs want wants would like help get make do does doing it its this that these those some any so as if all every how what who when where which please just also more most very ai agent agents service services business company companies small best custom new build create develop'.split(' '),
    );
    const stem = (w: string) => (w.length > 4 && w.endsWith('ies') ? w.slice(0, -3) + 'y' : w.length > 3 && w.endsWith('s') && !w.endsWith('ss') ? w.slice(0, -1) : w);
    const words = (s: string) => s.toLowerCase().replace(/[^a-z0-9/؀-ۿ]+/g, ' ').split(' ').filter(Boolean);
    const toks = (s: string) => words(s).filter((w) => !STOP.has(w)).map(stem);

    const sets = idx.items.map((it) => new Set(toks(`${it.kw} ${it.name}`)));
    const df = new Map<string, number>();
    sets.forEach((s) => s.forEach((t) => df.set(t, (df.get(t) ?? 0) + 1)));
    const idf = (t: string) => Math.log(1 + idx.items.length / (df.get(t) ?? idx.items.length));
    const indSets = idx.industries.map((i) => new Set(toks(i.kw)));

    const has = (text: string, re: RegExp) => re.test(text);

    function signals(text: string): string[] {
      const t = text.toLowerCase();
      const tk = new Set(toks(text));
      const out: string[] = [];
      out.push(has(t, /\b(build|app|website|site|platform|portal|mvp|develop|software|marketplace|dashboard)\b/) ? 'Goal: build a product' : 'Goal: automate the work');
      // the industry with the most hits wins ("dental clinic" → Dental clinics, not Healthcare)
      const hits = idx.industries
        .map((ind, i) => ({ ind, n: [...indSets[i]!].filter((w) => tk.has(w)).length, size: indSets[i]!.size }))
        .sort((a, b) => b.n - a.n || a.size - b.size);
      if (hits[0]?.n) out.push(`Industry: ${hits[0].ind.name}`);
      const ch: [RegExp, string][] = [
        [/\b(call|calls|phone|voice|voicemail)\b/, 'Phone'],
        [/whatsapp/, 'WhatsApp'],
        [/\b(email|emails|inbox)\b/, 'Email'],
        [/\b(instagram|facebook|tiktok|linkedin|social)\b/, 'Social'],
        [/\b(website|web chat|live chat|chatbot|site chat)\b/, 'Website chat'],
        [/\b(ios|android|mobile|iphone)\b/, 'Mobile'],
      ];
      const chans = ch.filter(([re]) => re.test(t)).map(([, n]) => n);
      if (chans.length) out.push(`Channel: ${chans.slice(0, 2).join(', ')}`);
      if (/[؀-ۿ]/.test(text) || /\b(urdu|roman urdu)\b/.test(t)) out.push('Language: Urdu');
      else if (/\barabic\b/.test(t)) out.push('Language: Arabic');
      if (/\b(asap|urgent|this week|next week|quickly|fast)\b/.test(t)) out.push('Timing: soon');
      return out.slice(0, 4);
    }

    function match(text: string): Item[] {
      const tk = toks(text);
      const raw = words(text);
      const scored = idx.items.map((it, i) => {
        let s = 0;
        for (const t of new Set(tk)) if (sets[i]!.has(t)) s += idf(t);
        for (let j = 0; j < raw.length - 1; j++) if (!STOP.has(raw[j]!) && !STOP.has(raw[j + 1]!) && it.kw.includes(` ${raw[j]} ${raw[j + 1]} `)) s += 1.5;
        return { it, s };
      });
      const top = scored.filter((x) => x.s >= 1.2).sort((a, b) => b.s - a.s);
      if (!top.length) return idx.items.filter((it) => /ai-agent-development|ai-consulting/.test(it.href));
      // keep matches close to the best one, at most 3
      const best = top[0]!.s;
      return top.filter((x) => x.s >= best * 0.35).slice(0, 3).map((x) => x.it);
    }

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, text?: string) => {
      const n = document.createElement(tag);
      n.className = cls;
      if (text) n.textContent = text;
      return n;
    };

    function run() {
      const text = input.value.trim();
      if (text.length < 3) {
        input.focus();
        return;
      }
      sigList.replaceChildren(...signals(text).map((s) => el('li', 'ph-s', s)));
      const items = match(text);
      matchList.replaceChildren(
        ...items.map((it) => {
          const li = el('li', '');
          const a = el('a', 'ph-m');
          a.href = it.href;
          a.append(el('span', 'ph-kind mono', it.t === 'a' ? 'Packaged agent' : 'Service'), el('strong', 'ph-name', it.name), el('span', 'ph-line', it.line));
          if (it.price) a.append(el('span', 'ph-price mono', it.price));
          li.append(a);
          return li;
        }),
      );
      const topic = items[0]?.href.split('/').filter(Boolean).pop() ?? '';
      quote.href = `/contact/?topic=${encodeURIComponent(topic)}&brief=${encodeURIComponent(text)}#quote`;
      const wasHidden = result.hidden;
      result.hidden = false;
      if (wasHidden) result.scrollIntoView({ block: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      window.dispatchEvent(new CustomEvent('vbx:track', { detail: { event: 'prompt_result', top: topic, n: items.length } }));
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      run();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
        e.preventDefault();
        run();
      }
    });
    root.querySelectorAll<HTMLButtonElement>('[data-fill]').forEach((b) =>
      b.addEventListener('click', () => {
        input.value = b.dataset.fill ?? '';
        run();
      }),
    );

    // Rotating example placeholder while the box is empty and not focused.
    let i = 0;
    setInterval(() => {
      if (document.hidden || input.value || document.activeElement === input) return;
      i = (i + 1) % idx.examples.length;
      input.placeholder = idx.examples[i]!;
    }, 3800);

    // Voice input where the browser supports it (Chrome, Edge, Safari).
    type Rec = { lang: string; interimResults: boolean; start(): void; stop(): void; onresult: ((e: any) => void) | null; onend: (() => void) | null; onerror: (() => void) | null };
    const SR: (new () => Rec) | undefined = (window as any).SpeechRecognition ?? (window as any).webkitSpeechRecognition;
    if (SR) {
      mic.hidden = false;
      let rec: Rec | null = null;
      mic.addEventListener('click', () => {
        if (rec) {
          rec.stop();
          return;
        }
        rec = new SR();
        rec.lang = navigator.language || 'en-US';
        rec.interimResults = true;
        rec.onresult = (e) => {
          input.value = Array.from(e.results as ArrayLike<{ 0: { transcript: string } }>)
            .map((r) => r[0].transcript)
            .join(' ');
        };
        rec.onend = () => {
          rec = null;
          mic.setAttribute('aria-pressed', 'false');
          if (input.value.trim()) run();
        };
        rec.onerror = () => rec?.stop();
        mic.setAttribute('aria-pressed', 'true');
        rec.start();
      });
    }
  }
</script>

<style>
  .ph {
    display: grid;
    gap: var(--space-3);
    inline-size: 100%;
    max-inline-size: 38rem;
    margin-block-start: var(--space-1);
  }
  .ph-box {
    --glass-radius: var(--radius-lg);
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-3) var(--space-2) var(--space-4);
    transition: box-shadow var(--dur-2) var(--ease-out);
  }
  .ph-box > * {
    position: relative;
    z-index: 2;
  }
  .ph-box:focus-within {
    box-shadow:
      var(--glass-shadow, var(--shadow-md)),
      0 0 0 2px color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .ph-row {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .ph-spark {
    flex: none;
    margin-block-start: 0.35rem;
    color: var(--accent);
  }
  .ph-row textarea {
    flex: 1;
    min-block-size: 3.4rem;
    padding: 0.25rem 0;
    border: 0;
    resize: none;
    font: inherit;
    font-size: var(--step-0);
    line-height: 1.5;
    color: var(--fg);
    background: transparent;
    field-sizing: content;
    max-block-size: 9rem;
  }
  .ph-row textarea:focus {
    outline: none;
  }
  .ph-row textarea::placeholder {
    color: var(--fg-subtle);
  }
  .ph-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-2);
  }
  .ph-hint {
    margin-inline-end: auto;
    font-size: 0.6875rem;
    color: var(--fg-subtle);
  }
  .ph-mic,
  .ph-send {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }
  .ph-mic {
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 9%, transparent);
  }
  .ph-mic[hidden] {
    display: none;
  }
  .ph-mic[aria-pressed='true'] {
    color: #fff;
    background: #dc2626;
    animation: ph-pulse 1.2s ease-in-out infinite;
  }
  .ph-send {
    color: var(--btn-primary-fg);
    background: var(--btn-primary-bg);
    box-shadow: var(--btn-primary-glow);
  }
  @keyframes ph-pulse {
    50% {
      box-shadow: 0 0 0 6px rgb(220 38 38 / 0.25);
    }
  }
  .ph-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .ph-chip {
    min-block-size: 2.25rem;
    padding: 0 0.85rem;
    border: 0;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 540;
    color: var(--fg);
    cursor: pointer;
  }
  .ph-chip:hover {
    color: var(--accent);
  }
  .ph-result {
    --glass-radius: var(--radius-lg);
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    scroll-margin-block: calc(var(--header-h) + 1rem) 2rem;
  }
  .ph-result[hidden] {
    display: none;
  }
  .ph-result > * {
    position: relative;
    z-index: 2;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ph-result:not([hidden]) {
      animation: ph-in 0.4s var(--ease-out);
    }
  }
  @keyframes ph-in {
    from {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }
  .ph-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
  .ph-label :global(.icon) {
    color: var(--accent);
  }
  .ph-sig {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .ph-sig :global(.ph-s) {
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    font-weight: 540;
    background: color-mix(in srgb, var(--accent) 11%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 24%, transparent);
  }
  .ph-matches {
    display: grid;
    gap: var(--space-2);
  }
  .ph-matches :global(.ph-m) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.1rem var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 5%, transparent);
    border: 1px solid var(--border);
    transition: border-color var(--dur-2) var(--ease-out);
  }
  .ph-matches :global(.ph-m:hover) {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
  }
  .ph-matches :global(.ph-kind) {
    grid-column: 1 / -1;
    font-size: 0.625rem;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
  }
  .ph-matches :global(.ph-name) {
    font-weight: 620;
  }
  .ph-matches :global(.ph-price) {
    grid-row: 2;
    grid-column: 2;
    align-self: center;
    font-size: 0.75rem;
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .ph-matches :global(.ph-line) {
    grid-column: 1 / -1;
    font-size: var(--step--1);
    color: var(--fg-muted);
  }
  @media (max-width: 30rem) {
    .ph-matches :global(.ph-price) {
      grid-row: auto;
      grid-column: 1 / -1;
    }
    .ph-hint {
      display: none;
    }
  }
  @media (max-width: 30rem) {
    .ph-chips li:nth-child(n + 5) {
      display: none;
    }
  }
  .ph-alt {
    margin-block-start: var(--space-1);
  }
</style>
