---
/** Inline SVG icon (build-time, zero JS). Decorative by default; pass `label` to make it meaningful. */
import { getIcon, type IconName } from '@/lib/icons';

interface Props {
  name: IconName;
  size?: number | string;
  label?: string;
  class?: string;
  strokeWidth?: number;
}
const { name, size = 20, label, class: className, strokeWidth = 1.75 } = Astro.props;
const { body, kind } = getIcon(name);
const strokeAttrs =
  kind === 'stroke'
    ? ({ fill: 'none', stroke: 'currentColor', 'stroke-width': strokeWidth, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const)
    : ({ fill: 'currentColor' } as const);
---

<svg
  class:list={['icon', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  {...strokeAttrs}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={body}
/>

<style>
  .icon {
    flex: none;
    width: var(--icon-size, auto);
    height: var(--icon-size, auto);
  }
</style>
