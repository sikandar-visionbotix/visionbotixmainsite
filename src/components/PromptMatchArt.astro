---
/**
 * Illustration of Wakeel's prompt-first flow (product page hero): a Roman Urdu prompt → the fields the AI extracts →
 * verified matches with a reason. Static HTML + CSS (rises in under motion-safe). Fictional, generic rows: no names,
 * no ratings, no numbers from the live product (CLAUDE.md: no unverified proof).
 */
import Icon from './Icon.astro';

const fields = [
  { k: 'City', v: 'Lahore' },
  { k: 'Case type', v: 'Property · tenancy' },
  { k: 'Court', v: 'Civil court' },
  { k: 'Budget', v: 'PKR 5k–15k' },
];
const matches = [
  { area: 'Property law', why: 'Handles tenancy and deposit disputes in Lahore civil courts' },
  { area: 'Civil litigation', why: 'Fee range fits the budget; takes first consultations by phone' },
];
---

<figure class="pm glass-strong" aria-label="Illustration: a prompt in Roman Urdu turned into a lawyer search">
  <div class="pm-bar">
    <span class="pm-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="mono small subtle">wakeel.com.pk</span>
  </div>

  <div class="pm-prompt glass-subtle">
    <p lang="ur-Latn">Mera landlord security deposit wapas nahi kar raha. Lahore mein hoon, budget 10k tak.</p>
    <span class="pm-mic" aria-hidden="true"><Icon name="mic" size={16} /></span>
  </div>

  <p class="pm-label mono"><Icon name="sparkles" size={13} /> Understood as</p>
  <ul role="list" class="pm-fields">
    {
      fields.map((f, i) => (
        <li style={`--i:${i}`}>
          <span class="mono">{f.k}</span>
          {f.v}
        </li>
      ))
    }
  </ul>

  <p class="pm-label mono"><Icon name="badge-check" size={13} /> Verified matches</p>
  <ul role="list" class="pm-matches">
    {
      matches.map((m, i) => (
        <li class="glass-subtle" style={`--i:${i + 4}`}>
          <span class="pm-avatar" aria-hidden="true"><Icon name="scale" size={16} /></span>
          <div>
            <p class="pm-area">
              Advocate · {m.area} <span class="pm-ok"><Icon name="check" size={12} strokeWidth={3} /> Verified</span>
            </p>
            <p class="small muted">Why: {m.why}</p>
          </div>
        </li>
      ))
    }
  </ul>
  <figcaption class="pm-cap mono">Illustration · fictional example, not real profiles</figcaption>
</figure>

<style>
  .pm {
    --glass-radius: var(--radius-xl);
    display: grid;
    gap: var(--space-3);
    inline-size: 100%;
    max-inline-size: 32rem;
    margin: 0;
    padding: clamp(1rem, 0.75rem + 1vw, 1.5rem);
  }
  .pm > * {
    position: relative;
    z-index: 2;
  }
  .pm-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .pm-dots {
    display: flex;
    gap: 0.3rem;
  }
  .pm-dots i {
    inline-size: 0.55rem;
    block-size: 0.55rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--fg) 22%, transparent);
  }
  .pm-prompt {
    --glass-radius: var(--radius-lg);
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
    padding: var(--space-4);
    font-size: var(--step-0);
    line-height: 1.45;
  }
  .pm-prompt > * {
    position: relative;
    z-index: 2;
  }
  .pm-mic {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border-radius: 50%;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
  }
  .pm-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-block-start: var(--space-1);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
  .pm-label :global(.icon) {
    color: var(--accent);
  }
  .pm-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }
  .pm-fields li {
    display: grid;
    gap: 0.1rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
    font-size: var(--step--1);
    font-weight: 560;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .pm-fields .mono {
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .pm-matches {
    display: grid;
    gap: var(--space-2);
  }
  .pm-matches li {
    --glass-radius: var(--radius-md);
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-3);
  }
  .pm-matches li > * {
    position: relative;
    z-index: 2;
  }
  .pm-avatar {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: 50%;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .pm-area {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step--1);
    font-weight: 600;
  }
  .pm-ok {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.05rem 0.45rem;
    border-radius: var(--radius-pill);
    font-size: 0.6875rem;
    font-weight: 560;
    color: var(--success, #16a34a);
    background: color-mix(in srgb, #22c55e 14%, transparent);
  }
  .pm-cap {
    font-size: 0.6875rem;
    color: var(--fg-subtle);
    text-align: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .pm-fields li,
    :global(html.js) .pm-matches li {
      animation: pm-rise 0.5s var(--ease-out) both;
      animation-delay: calc(0.35s + var(--i) * 0.12s);
    }
  }
  @keyframes pm-rise {
    from {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }
</style>
