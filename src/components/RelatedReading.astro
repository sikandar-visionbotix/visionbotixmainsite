---
/**
 * "Guides on this topic" (S10): the spoke → hub links back from a money page (agent, service, industry, country,
 * pricing) to the posts that sell into it (PLAN §6.3). Renders nothing when no post links to the page.
 */
import Section from '@/components/Section.astro';
import PostCard from '@/components/PostCard.astro';
import { guidesFor } from '@/lib/posts';

interface Props {
  /** The money page's own path, e.g. /ai-agents/ai-receptionist/ (defaults to the current URL). */
  path?: string;
  title?: string;
}
const path = Astro.props.path ?? Astro.url.pathname;
const posts = await guidesFor(path);
const { title = posts.length === 1 ? 'A guide on this topic.' : 'Guides on this topic.' } = Astro.props;
---

{
  posts.length > 0 && (
    <Section id="guides" eyebrow="Resources" title={title} space="tight">
      <ul role="list" class="guides" data-stagger>
        {posts.map((p) => <PostCard post={p} />)}
      </ul>
    </Section>
  )
}

<style>
  .guides {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
</style>
