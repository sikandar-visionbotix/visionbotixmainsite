---
/** Renders one JSON-LD block. `<` is escaped so content can never close the script tag. */
import type { Thing } from '@/lib/schema';
interface Props {
  data: Thing;
}
const json = JSON.stringify(Astro.props.data).replace(/</g, '\\u003c');
---

<script type="application/ld+json" set:html={json} />
